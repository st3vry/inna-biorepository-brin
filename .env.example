API_HRMS=
API_HRMS_PROD=
API_SSO=
API_AUTH=
API_INTRA=
API_ELSA=

API_INNAKM_BASE_URL=
API_INNAKM_TIMEOUT=10
API_DATAVERSE_BASE_URL=
